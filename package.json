{
  "name": "vineeth-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio + RAG chatbot for Vineeth Reddy Kodakandla",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "embed": "node --env-file=.env.local scripts/embed.mjs",
