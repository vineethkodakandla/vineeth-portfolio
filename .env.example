# ════════════════════════════════════════════════════════════════════════
#  Every external service below is feature-detected at runtime. If a key is
#  missing, that feature degrades and the app still builds and runs.
#  Without ANTHROPIC_API_KEY the chatbot is hidden.
# ════════════════════════════════════════════════════════════════════════

# ── Chatbot answers ─────────────────────────────────────────────────────
# https://console.anthropic.com  → API Keys. The chat endpoint is public, so
# set a monthly spend limit on this key as well.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Optional model override. Leave unset to use the default in
# app/api/chat/route.ts (claude-opus-5).
# CHAT_MODEL=
# Answers allowed per day across all visitors (default 400). Shared between
# instances through Redis; without Redis each instance allows up to 100.
# CHAT_DAILY_LIMIT=400

# ── Database: Neon Postgres + pgvector ──────────────────────────────────
# https://neon.tech  → create project → copy the POOLED connection string.
# Missing → retrieval falls back to the whole bundled knowledge base, contact
# messages are emailed but not stored, and page views are not logged.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# ── Embeddings: Voyage (per-question vector retrieval) ──────────────────
# https://www.voyageai.com  → API Keys. After editing data/knowledge.json,
# run `npm run embed` to re-index.
# Missing → the whole knowledge base goes into every prompt.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite

# ── Redis: Upstash (rate limits, the daily chat budget, view counters) ──
# https://upstash.com  → create Redis DB → REST URL + token.
# Missing → per-instance in-memory limits, which reset on each cold start;
# view counts come from Postgres instead (zero if DATABASE_URL is also unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email: Resend (contact-form notifications) ──────────────────────────
# https://resend.com  → API key + verify a sending domain/sender.
# Missing → submissions are stored in Postgres but no email is sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=vineethkodakandla@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ── Error monitoring: Sentry (optional) ─────────────────────────────────
# https://sentry.io  → create a Next.js project.
# Missing → Sentry is never initialised and sends nothing, and the browser
# bundle does not load it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── SEO / metadata ──────────────────────────────────────────────────────
# Used for canonical URLs, the sitemap, robots and OpenGraph images.
# Missing → on Vercel, the production domain (VERCEL_PROJECT_PRODUCTION_URL);
# locally, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Metrics endpoint guard ──────────────────────────────────────────────
# Bearer token required to read /api/metrics. Missing → endpoint returns 401.
METRICS_TOKEN=
